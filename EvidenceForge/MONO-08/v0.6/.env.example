# EvidenceForge — MONO-08 — .env.example
# Copier vers .env et renseigner reellement dans un environnement autorise.
# Ne jamais committer .env avec de vraies valeurs.

# --- MONO-08 v0.6 : mode d'authentification LLM ---
# LLM_AUTH_MODE ∈ { absent -> direct, "direct", "delegated" }.
# Toute autre valeur explicite est un PRODUCT_CONFIG_ERROR (exit code 3) :
# aucun provider n'est appele, aucune requete reseau n'est emise.
# Voir EvidenceForge/MONO-08/MONO-08-v0.6-DELEGATED-LLM-AUTH-CDC.md section 4.
LLM_AUTH_MODE=direct

# --- Mode direct : credential envoye directement par EvidenceForge ---
# Jamais lu/demande/transmis en mode delegated (jamais affiche, uniquement
# sa presence est verifiee).
ANTHROPIC_API_KEY=

# --- Mode delegated : credential du Worker evidenceforge-llm-proxy ---
# EvidenceForge ne connait et n'envoie QUE ce credential en mode delegated ;
# ANTHROPIC_API_KEY reste exclusivement cote Cloudflare, jamais lue ici.
# Voir worker/evidenceforge-llm-proxy/README.md.
EVIDENCEFORGE_WORKER_API_KEY=

# --- Fournisseurs reels (URLs de base par defaut deja codees si absentes) ---
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_BASE_URL=https://api.crossref.org
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov
# Mode direct : URL Anthropic reelle (defaut). Mode delegated : URL du
# Worker evidenceforge-llm-proxy reellement deploye (ex.
# https://evidenceforge-llm-proxy.<subdomain>.workers.dev) — jamais
# localhost/127.0.0.1/synthetic/mock/fixture (assertNotLocalOrSynthetic()).
LLM_WORKER_BASE_URL=https://api.anthropic.com

# --- Repertoires (jamais un chemin de session — a fournir explicitement) ---
EVIDENCEFORGE_REAL_SMOKE_DATA_DIR=
EVIDENCEFORGE_PERSISTENCE_DIR=

# --- Kit MONO-07/baseline R3 (chemin du kit contenant les ZIP canoniques) ---
EVIDENCEFORGE_KIT_ROOT=

# --- Timeouts (millisecondes) ---
EVIDENCEFORGE_HTTP_TIMEOUT_MS=8000
