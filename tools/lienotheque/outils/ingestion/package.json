{
  "name": "@lienotheque/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D'un rejeu de recette au dépôt réel : fichiers, document, version, ancres, cartes de synchronisation et liens.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "traiter": "tsx src/traiter.ts",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lienotheque/contrats": "workspace:*",
    "@lienotheque/noyau": "workspace:*",
    "@lienotheque/recettes": "workspace:*",
    "@lienotheque/cache": "workspace:*",
    "@lienotheque/images": "workspace:*",
    "@lienotheque/formats": "workspace:*",
    "@lienotheque/optimiseur": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0",
    "@lienotheque/depot-sqlite": "workspace:*"
  }
}
