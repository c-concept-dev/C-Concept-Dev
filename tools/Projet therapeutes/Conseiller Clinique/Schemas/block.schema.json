{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.schema.json",
  "$comment": "UX-8A — union discriminée des blocs de ClinicalDocument, par `type` (const). Pas de `content` libre : chaque type a un schéma de contenu propre, additionalProperties:false à tous les niveaux. `card` est réservé au niveau racine d'un Carrousel (voir $defs/cardOnlyRootBlocks dans clinical-document.schema.json) ; les blocs imbriqués dans `card.content.blocks[]` utilisent $defs/nestedBlock (tous les types sauf `card` et `table`, cf. §UX-8A du CDC).",
  "$defs": {
    "citationLink": {
      "type": "object",
      "required": [
        "citationId",
        "claimText",
        "claimSupport"
      ],
      "additionalProperties": false,
      "properties": {
        "citationId": {
          "type": "string",
          "minLength": 1
        },
        "claimText": {
          "type": "string",
          "minLength": 1
        },
        "claimSupport": {
          "enum": [
            "pass",
            "needs-review",
            "pending"
          ]
        }
      }
    },
    "blockValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citationLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citationLink"
          }
        },
        "citationReviewRequired": {
          "type": "boolean",
          "$comment": "UX-11 (correction ciblée d'un bloc) — vrai si une correction substantielle du texte ne permet plus de garantir le lien avec les citationLinks d'origine avec confiance. Jamais utilisé pour modifier une citation elle-même, uniquement pour signaler qu'elle mérite une relecture humaine."
        }
      }
    },
    "citationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockStyle": {
      "$comment": "Item 57c Lot 2 — style manuel PAR BLOC (heading/paragraph uniquement), à côté de la charte globale du document (render-manifest.schema.json) — jamais un remplacement de celle-ci, un raffinement optionnel sur un bloc précis. Tous les champs optionnels ; fontPairId référence ADOC_LEGACY_FONT_PAIRS (code client, jamais une seconde liste de polices) donc laissé en chaîne libre non-vide plutôt qu'un enum dupliqué ici — sa validité réelle est garantie par construction : seul un <select> aux options fixes en écrit la valeur, jamais une saisie libre. color est produit exclusivement par <input type=color>, qui ne peut produire qu'un hex 7 caractères en minuscules — le pattern ne fait que documenter cette garantie déjà assurée côté UI, pas la seule ligne de défense.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontPairId": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "maxLength": 200
        },
        "fontSize": {
          "enum": [
            "small",
            "normal",
            "large",
            "xlarge"
          ]
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 200
        },
        "backgroundColor": {
          "type": "string",
          "maxLength": 200
        },
        "fontWeight": {
          "type": "string",
          "maxLength": 200
        },
        "fontStyle": {
          "type": "string",
          "maxLength": 200
        },
        "textDecoration": {
          "type": "string",
          "maxLength": 200
        },
        "textAlign": {
          "type": "string",
          "maxLength": 200
        },
        "textTransform": {
          "type": "string",
          "maxLength": 200
        },
        "borderColor": {
          "type": "string",
          "maxLength": 200
        },
        "fontSizePt": {
          "type": "number",
          "minimum": 6,
          "maximum": 144
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -2,
          "maximum": 20
        },
        "marginTop": {
          "type": "number",
          "minimum": 0,
          "maximum": 160
        },
        "marginBottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 160
        },
        "textIndent": {
          "type": "number",
          "minimum": 0,
          "maximum": 160
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "headingContent": {
      "type": "object",
      "required": [
        "text",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "paragraphContent": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "calloutContent": {
      "type": "object",
      "required": [
        "text",
        "visualRole"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "visualRole": {
          "enum": [
            "info",
            "warning",
            "critical",
            "success"
          ]
        }
      }
    },
    "listContent": {
      "type": "object",
      "required": [
        "items",
        "ordered"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ordered": {
          "type": "boolean"
        }
      }
    },
    "tableContent": {
      "type": "object",
      "required": [
        "headers",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "quoteContent": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "imageContent": {
      "$comment": "UX-8A.2 — bloc d'illustration autonome (pas une image de couverture de card). `query` est la requête de recherche Pexels résolue par le mécanisme existant et éprouvé (app hôte, adocResolveImages, via data-pexels=) — jamais une URL en dur. `alt` est toujours requis et non vide.",
      "type": "object",
      "required": [
        "query",
        "alt"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cardContent": {
      "$comment": "imageAlt : requis (non vide) dès que imageRef est renseigné — le contrat de contrôle qualité UX-8A traite un texte alternatif absent sur une image informative comme bloquant. Reste optionnel/null quand imageRef est null (pas d'image, rien à décrire).",
      "type": "object",
      "required": [
        "title",
        "imageRef",
        "imageAlt",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "imageRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageAlt": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nestedBlock"
          }
        }
      },
      "if": {
        "properties": {
          "imageRef": {
            "type": "string"
          }
        },
        "required": [
          "imageRef"
        ]
      },
      "then": {
        "properties": {
          "imageAlt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "headingBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "heading"
        },
        "content": {
          "$ref": "#/$defs/headingContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "paragraph"
        },
        "content": {
          "$ref": "#/$defs/paragraphContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "calloutBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "callout"
        },
        "content": {
          "$ref": "#/$defs/calloutContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "listBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "list"
        },
        "content": {
          "$ref": "#/$defs/listContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "table"
        },
        "content": {
          "$ref": "#/$defs/tableContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "quoteBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "quote"
        },
        "content": {
          "$ref": "#/$defs/quoteContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        },
        "style": {
          "$ref": "#/$defs/blockStyle"
        },
        "editor": {
          "$ref": "#/$defs/editorPresentation"
        }
      }
    },
    "cardBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "card"
        },
        "content": {
          "$ref": "#/$defs/cardContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "image"
        },
        "content": {
          "$ref": "#/$defs/imageContent"
        },
        "citationIds": {
          "$ref": "#/$defs/citationIds"
        },
        "validation": {
          "$ref": "#/$defs/blockValidation"
        }
      }
    },
    "editorialBlock": {
      "$comment": "Blocs éditoriaux autorisés au niveau racine d'une Fiche synthèse (documentKind:'fiche') : tous les types sauf `card`.",
      "oneOf": [
        {
          "$ref": "#/$defs/headingBlock"
        },
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "$ref": "#/$defs/calloutBlock"
        },
        {
          "$ref": "#/$defs/listBlock"
        },
        {
          "$ref": "#/$defs/tableBlock"
        },
        {
          "$ref": "#/$defs/quoteBlock"
        },
        {
          "$ref": "#/$defs/imageBlock"
        }
      ]
    },
    "nestedBlock": {
      "$comment": "Blocs autorisés dans card.content.blocks[] (imbriqué) : mêmes types que l'ensemble éditorial, sauf `table` (non imbriquée) et `card` (jamais imbriquée dans une autre carte).",
      "oneOf": [
        {
          "$ref": "#/$defs/headingBlock"
        },
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "$ref": "#/$defs/calloutBlock"
        },
        {
          "$ref": "#/$defs/listBlock"
        },
        {
          "$ref": "#/$defs/quoteBlock"
        },
        {
          "$ref": "#/$defs/imageBlock"
        }
      ]
    },
    "cardOnlyBlock": {
      "$comment": "Bloc autorisé au niveau racine d'un Carrousel (documentKind:'carrousel') : exclusivement `card`.",
      "oneOf": [
        {
          "$ref": "#/$defs/cardBlock"
        }
      ]
    },
    "editorPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "op",
              "value",
              "color"
            ],
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "op": {
                "enum": [
                  "gt",
                  "lt",
                  "eq"
                ]
              },
              "value": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "cells": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rowSpan": {
                "type": "integer",
                "minimum": 1
              },
              "colSpan": {
                "type": "integer",
                "minimum": 1
              },
              "style": {
                "$ref": "#/$defs/blockStyle"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/headingBlock"
    },
    {
      "$ref": "#/$defs/paragraphBlock"
    },
    {
      "$ref": "#/$defs/calloutBlock"
    },
    {
      "$ref": "#/$defs/listBlock"
    },
    {
      "$ref": "#/$defs/tableBlock"
    },
    {
      "$ref": "#/$defs/quoteBlock"
    },
    {
      "$ref": "#/$defs/cardBlock"
    },
    {
      "$ref": "#/$defs/imageBlock"
    }
  ]
}
