{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.schema.json",
  "$comment": "UX-8A — union discriminée des blocs de ClinicalDocument, par `type` (const). Pas de `content` libre : chaque type a un schéma de contenu propre, additionalProperties:false à tous les niveaux. `card` est réservé au niveau racine d'un Carrousel (voir $defs/cardOnlyRootBlocks dans clinical-document.schema.json) ; les blocs imbriqués dans `card.content.blocks[]` utilisent $defs/nestedBlock (tous les types sauf `card` et `table`, cf. §UX-8A du CDC).",
  "$defs": {
    "citationLink": {
      "type": "object",
      "required": ["citationId", "claimText", "claimSupport"],
      "additionalProperties": false,
      "properties": {
        "citationId": { "type": "string", "minLength": 1 },
        "claimText": { "type": "string", "minLength": 1 },
        "claimSupport": { "enum": ["pass", "needs-review", "pending"] }
      }
    },
    "blockValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citationLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/citationLink" }
        }
      }
    },
    "citationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },

    "headingContent": {
      "type": "object",
      "required": ["text", "level"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "level": { "enum": [1, 2, 3] }
      }
    },
    "paragraphContent": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "calloutContent": {
      "type": "object",
      "required": ["text", "visualRole"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "visualRole": { "enum": ["info", "warning", "critical", "success"] }
      }
    },
    "listContent": {
      "type": "object",
      "required": ["items", "ordered"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ordered": { "type": "boolean" }
      }
    },
    "tableContent": {
      "type": "object",
      "required": ["headers", "rows"],
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "quoteContent": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "cardContent": {
      "$comment": "imageAlt : requis (non vide) dès que imageRef est renseigné — le contrat de contrôle qualité UX-8A traite un texte alternatif absent sur une image informative comme bloquant. Reste optionnel/null quand imageRef est null (pas d'image, rien à décrire).",
      "type": "object",
      "required": ["title", "imageRef", "imageAlt", "blocks"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "imageRef": { "type": ["string", "null"] },
        "imageAlt": { "type": ["string", "null"] },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/nestedBlock" }
        }
      },
      "if": { "properties": { "imageRef": { "type": "string" } }, "required": ["imageRef"] },
      "then": { "properties": { "imageAlt": { "type": "string", "minLength": 1 } } }
    },

    "headingBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "heading" },
        "content": { "$ref": "#/$defs/headingContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "paragraph" },
        "content": { "$ref": "#/$defs/paragraphContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "calloutBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "callout" },
        "content": { "$ref": "#/$defs/calloutContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "listBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "list" },
        "content": { "$ref": "#/$defs/listContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "table" },
        "content": { "$ref": "#/$defs/tableContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "quoteBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "quote" },
        "content": { "$ref": "#/$defs/quoteContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },
    "cardBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "card" },
        "content": { "$ref": "#/$defs/cardContent" },
        "citationIds": { "$ref": "#/$defs/citationIds" },
        "validation": { "$ref": "#/$defs/blockValidation" }
      }
    },

    "editorialBlock": {
      "$comment": "Blocs éditoriaux autorisés au niveau racine d'une Fiche synthèse (documentKind:'fiche') : tous les types sauf `card`.",
      "oneOf": [
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/calloutBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/quoteBlock" }
      ]
    },
    "nestedBlock": {
      "$comment": "Blocs autorisés dans card.content.blocks[] (imbriqué) : mêmes types que l'ensemble éditorial, sauf `table` (non imbriquée) et `card` (jamais imbriquée dans une autre carte).",
      "oneOf": [
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/calloutBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/quoteBlock" }
      ]
    },
    "cardOnlyBlock": {
      "$comment": "Bloc autorisé au niveau racine d'un Carrousel (documentKind:'carrousel') : exclusivement `card`.",
      "oneOf": [
        { "$ref": "#/$defs/cardBlock" }
      ]
    }
  },

  "oneOf": [
    { "$ref": "#/$defs/headingBlock" },
    { "$ref": "#/$defs/paragraphBlock" },
    { "$ref": "#/$defs/calloutBlock" },
    { "$ref": "#/$defs/listBlock" },
    { "$ref": "#/$defs/tableBlock" },
    { "$ref": "#/$defs/quoteBlock" },
    { "$ref": "#/$defs/cardBlock" }
  ]
}
