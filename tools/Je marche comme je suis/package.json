{
  "name": "je-marche-comme-je-suis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "audit:fields": "node scripts/audit-fields.mjs",
    "check": "npm run build && npm run audit:fields && npm test",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --grep @critical",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "p0.1:verify": "npm run check && npm run e2e:critical"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0"
  }
}
