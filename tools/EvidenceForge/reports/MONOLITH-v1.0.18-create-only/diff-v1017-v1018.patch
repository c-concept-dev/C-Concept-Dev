umns:repeat(auto-fill,minmax(210px,1fr));gap:8px}.steps li{border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13px;background:#fff}\n.steps li.DONE{border-color:var(--ok);background:#f0f8f2}.steps li.RUNNING{border-color:var(--accent);background:var(--soft)}.steps li.INTERRUPTED,.steps li.FAILED{border-color:var(--bad);background:#fbf0f0}\n.pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;border:1px solid var(--line);background:#fff}.docrow{margin:2px 0;font-size:.92em}.pill.ok{border-color:var(--ok);color:var(--ok)}.pill.warn{border-color:var(--warn);color:var(--warn)}.pill.bad{border-color:var(--bad);color:var(--bad)}\n.banner{padding:12px 14px;border-radius:8px;border:1px solid;margin:10px 0}.banner.warn{border-color:var(--warn);background:#fff8ec}.banner.bad{border-color:var(--bad);background:#fbf0f0}.banner.ok{border-color:var(--ok);background:#f0f8f2}.banner.info{border-color:var(--accent);background:var(--soft)}\n.log{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;max-height:220px;overflow:auto;background:#fafaf7;border:1px solid var(--line);border-radius:8px;padding:8px}\ntable{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}\n.src{border:1px solid var(--line);border-radius:8px;padding:10px;margin:8px 0;background:#fff}.src .t{font-weight:600}.src .r{font-size:13px;color:var(--muted);margin-top:4px}\n.src.noprop{border-color:var(--warn);background:#fffaf0}.dec{display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;align-items:center}.dec button{border:1px solid var(--line);background:#fff;padding:4px 10px;border-radius:999px;cursor:pointer;font-size:12px}.dec button.on.inclus{background:#e6f4ea;border-color:var(--ok)}.dec button.on.exclu{background:#fbecec;border-color:var(--bad)}.dec button.on.doublon{background:#eee}\ndetails{margin:6px 0}summary{cursor:pointer;font-weight:600}\n.stmt{border-left:4px solid var(--line);padding:8px 12px;margin:8px 0;background:#fff;border-radius:0 8px 8px 0}.stmt.etabli{border-left-color:var(--ok)}.stmt.convergent{border-left-color:var(--accent)}.stmt.divergent{border-left-color:var(--warn)}.stmt.provisoire{border-left-color:#888}.stmt.nonEtabli{border-left-color:var(--bad)}\n.why{font-size:13px;background:#fafaf7;border:1px solid var(--line);border-radius:8px;padding:8px;margin-top:6px}\npre{white-space:pre-wrap;word-break:break-word;font-size:12px;background:#fafaf7;border:1px solid var(--line);border-radius:8px;padding:8px;max-height:420px;overflow:auto}\n.hash{font-family:ui-monospace,Menlo,monospace;font-size:12px;word-break:break-all}\n#report,#report li,#report p,#report div,.stmt,.why,.banner,.src{overflow-wrap:anywhere;word-break:break-word;min-width:0}\nmain{overflow-x:hidden}.card{max-width:100%}\n.notify{position:sticky;top:52px;z-index:4}\n.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.tabs button{border:1px solid var(--line);background:#fff;padding:5px 10px;border-radius:6px;cursor:pointer;font-size:13px}.tabs button.on{background:var(--soft);border-color:var(--accent)}\n[hidden]{display:none!important}\n/* v1.0.5 : cout / budget / portefeuille / aide ; v1.0.6 : apercu du decoupage automatique des documents (AUTO-CHUNK UPLOAD) */\n.cost{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:8px 0}.cost .k{font-size:12px;color:var(--muted)}.cost .v{font-weight:650;font-size:16px}.cost .cell{border:1px solid var(--line);border-radius:8px;padding:8px;background:#fff}\n.bar{display:inline-block;height:10px;background:var(--accent);border-radius:3px;vertical-align:middle}.bar.warn{background:var(--warn)}.bar.bad{background:var(--bad)}\n.covrow{display:grid;grid-template-columns:minmax(160px,1fr) 2fr auto;gap:8px;align-items:center;font-size:13px;padding:3px 0}\n.tag{display:inline-block;font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 5px;margin-left:4px;background:#fff}\n#helpCard h3{margin-top:12px}#helpCard p,#helpCard li{font-size:14px}\ninput[type=number]{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;font:inherit;background:#fff}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media (max-width:600px){.grid2{grid-template-columns:1fr}}\n@media print{header,.noprint,#runCard .steps,#runCard details,#runCard #userMsg,#runCard #resumeBox{display:none!important}main{max-width:none;padding:0}body{background:#fff}.card{border:0;margin:0;padding:0;page-break-inside:auto}#runCard{page-break-after:avoid}.stmt,.why,.banner{page-break-inside:avoid}.why{border:1px solid #ccc}details.why[open]>summary{display:none}.tech-details{display:none!important}.stmt{border-left-width:3px}}\n@media (max-width:600px){main{padding:10px}.steps{grid-template-columns:1fr 1fr}header h1{font-size:16px}}\n</style>\n</head>\n<body>\n<header>\n  <h1>EvidenceForge</h1><span class=\"sub\" id=\"cfgline\">…</span><span class=\"grow\"></span>\n  <div class=\"mode noprint\"><button id=\"mSimple\" class=\"on\">Mode simple</button><button id=\"mExpert\">Mode expert</button><button id=\"btnHelp\" title=\"Comment utiliser EvidenceForge ?\">Aide</button></div>\n</header>\n<main>\n  <div id=\"gateNotify\" class=\"banner warn noprint notify\" hidden></div>\n  <div id=\"gateErr\" class=\"banner bad noprint\" hidden></div>\n  <div id=\"providerWarn\" class=\"banner bad noprint\" hidden></div>\n\n  <!-- v1.0.5 : AIDE (jamais affichee par defaut, jamais bloquante) -->\n  <div class=\"card noprint\" id=\"helpCard\" hidden>\n    <div class=\"row\"><h2>Comment utiliser EvidenceForge ?</h2><span class=\"grow\"></span><button class=\"btn sec small\" id=\"btnHelpClose\">Fermer</button></div>\n    <h3>Ce qu'est EvidenceForge</h3><p>Un outil qui fait examiner votre demande par des <b>jumeaux documentaires</b> : des analyses construites uniquement à partir des publications réelles de professionnels identifiés dans une base de publications. Il distingue ce qui est <b>établi</b>, <b>convergent</b>, <b>divergent</b>, <b>provisoire</b> ou <b>non établi</b> dans ce processus.</p>\n    <h3>Ce qu'il n'est pas</h3><p>Ce n'est ni une validation scientifique, ni un avis de professionnels réels, ni une réponse générée librement par une IA. Aucune décision n'est prise à votre place : deux portes exigent votre acte réel, enregistré à votre nom.</p>\n    <h3>Les étapes</h3><ol><li><b>Comprendre votre demande</b> — reformulation, à confirmer.</li><li><b>Angles d'expertise</b> et <b>plan de recherche</b> — proposés automatiquement.</li><li><b>Porte 1</b> : vous vérifiez la compréhension, les angles et le plan, puis vous confirmez et lancez (rien n'est lancé avant).</li><li><b>Recherche des publications</b> et <b>tri proposé</b> source par source, puis <b>revue d'ensemble</b> du corpus (redondances, couverture des angles, méthodes hors domaine).</li><li><b>Porte 2</b> : vous ratifiez la sélection des publications (vous pouvez inverser chaque choix). C'est le seul acte qui constitue le corpus.</li><li><b>Professionnels</b> — découverte et évaluation, dans la limite d'un plafond de garde.</li><li><b>Jumeaux documentaires</b>, revues, agrégation, qualification, rapport.</li></ol>\n    <h3>Lire le rapport</h3><p><b>Établi</b> = plusieurs analyses indépendantes documentées convergent. <b>Convergent</b> = compatibles mais avec inférence prudente. <b>Divergent</b> = positions incompatibles, EvidenceForge ne tranche pas. <b>Provisoire</b> = un seul jumeau ou inférence prudente. <b>Non établi</b> = non déterminable, manque documentaire ou convergence rejetée. Chaque énoncé porte un « Pourquoi EvidenceForge dit cela ? » qui remonte aux constats et aux publications.</p>\n    <h3>Le coût</h3><p>Chaque appel au service d'analyse est facturé. Le bloc « Coût du run » affiche ce qui est <b>réellement dépensé</b> (journal de coût, tarif versionné) et, séparément, une <b>projection</b> marquée ESTIMATE — NOT GUARANTEE. Vous pouvez fixer un <b>budget maximum</b> et un <b>seuil d'alerte</b> avant ou pendant le run : au plafond, le run s'arrête proprement avant tout nouvel appel, conserve ses résultats, et peut reprendre après augmentation du budget.</p>\n    <h3>Bien cadrer une demande</h3><p>Décrivez ce que vous voulez faire examiner, sur quel périmètre, avec quels documents. « Vérifier ma demande avec l'IA » signale ambiguïtés, termes orientants, périmètre flou ou documents manquants et propose une reformulation : vous seul décidez de l'utiliser, de la modifier ou de garder votre texte.</p>\n    <h3>Limites et reprises</h3><p>Seuls les textes bruts (.txt, .md) sont lus. Une panne du fournisseur, du réseau ou un budget atteint arrête le run proprement : « Reprendre le run » repart de ce qui est déjà validé, sans recompter les réponses déjà obtenues.</p>\n  </div>\n\n  <!-- ================= MODE SIMPLE ================= -->\n  <section id=\"simple\">\n    <div class=\"card\" id=\"newRun\">\n      <h2>Que voulez-vous faire examiner ?</h2>\n      <p class=\"muted small\">Décrivez votre demande. Vous pouvez joindre des documents texte (.txt, .md). EvidenceForge reformule votre demande, la fait analyser par des jumeaux documentaires de professionnels identifiés dans les publications réelles, puis rédige un rapport en distinguant ce qui est établi, convergent, divergent, provisoire ou non établi.</p>\n      <label for=\"q\">Votre demande</label><textarea id=\"q\" placeholder=\"Ex. : Examiner ce cahier des charges et dire ce qui est étayé, discuté ou non établi…\"></textarea>\n      <label for=\"files\">Documents (facultatif)</label><input type=\"file\" id=\"files\" multiple accept=\".txt,.md\">\n      <div id=\"fileList\" class=\"small muted\"></div>\n      <!-- v1.0.5 : controle de cadrage AVANT la Porte 1 (hors run) — l'IA propose, vous decidez -->\n      <div class=\"row\" style=\"margin-top:10px\"><button class=\"btn sec\" id=\"btnPreflight\">Vérifier ma demande avec l'IA</button><span class=\"small muted\">Un appel facturé, hors run : signale les problèmes de cadrage et propose une reformulation. Ne modifie rien sans votre choix.</span></div>\n      <div id=\"preflightBox\" class=\"banner info\" hidden></div>\n      <!-- v1.0.5 : budget du run -->\n      <details style=\"margin-top:10px\" id=\"budgetDetails\" open><summary>Combien suis-je prêt à dépenser ? (budget du run, <b>requis</b>)</summary>\n        <div class=\"row\"><label><input type=\"radio\" name=\"bMode\" id=\"bModeLimited\" value=\"LIMITED\" checked> Plafond de coût (recommandé)</label><label><input type=\"radio\" name=\"bMode\" id=\"bModeUnlimited\" value=\"UNLIMITED\"> Sans plafond (confirmation explicite requise)</label></div>\n        <div class=\"grid2\"><div><label for=\"bMax\">Plafond de coût (USD, requis)</label><input type=\"number\" id=\"bMax\" min=\"0\" step=\"0.01\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ex. 25\"></div><div><label for=\"bWarn\">Alerte (USD, facultatif, inférieure au plafond)</label><input type=\"number\" id=\"bWarn\" min=\"0\" step=\"0.01\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ex. 20\"></div></div>\n        <p class=\"small\" id=\"bPreview\">Indiquez un plafond de coût.</p>\n        <p class=\"small muted\">Au plafond, le run s'arrête proprement avant tout nouvel appel payant ; il pourra reprendre après augmentation du budget. Un champ vide n'est jamais interprété comme « sans plafond » : sans plafond, vous devez le confirmer explicitement.</p></details>\n      <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn\" id=\"start\">Analyser ma demande</button><span class=\"small muted\">Rien n'est lancé sans votre confirmation à l'étape suivante.</span></div>\n      <details style=\"margin-top:12px\"><summary>Reprendre un run existant</summary><div id=\"runList\" class=\"small\"></div></details>\n      <details style=\"margin-top:6px\"><summary>Importer un rapport JSON exporté</summary><div class=\"small muted\">Le rapport est ré-affiché tel quel après vérification de son hash canonique. Les artefacts détaillés du run d'origine ne sont pas inclus dans un export JSON.</div><input type=\"file\" id=\"importReport\" accept=\".json,application/json\"><div id=\"importErr\" class=\"banner bad\" hidden></div></details>\n    </div>\n\n    <div class=\"card\" id=\"runCard\" hidden>\n      <div class=\"row\"><h2 id=\"runTitle\">Analyse en cours</h2><span class=\"pill\" id=\"runStatus\">…</span><span class=\"grow\"></span><button class=\"btn sec small noprint\" id=\"btnNew\">Nouvelle demande</button></div>\n      <p class=\"small muted\" id=\"runQuestion\"></p>\n      <ul class=\"steps\" id=\"steps\"></ul>\n      <div id=\"userMsg\" class=\"banner info\" hidden></div>\n      <!-- v1.0.5 : COUT DU RUN (reel) + projection (separee) + budget -->\n      <div id=\"costBox\" hidden>\n        <h3>Coût du run <span class=\"small muted\" id=\"costPricing\"></span></h3>\n        <div class=\"cost\" id=\"costCells\"></div>\n        <div id=\"costForecast\" class=\"small\"></div>\n        <div id=\"costBudget\" class=\"small\"></div>\n        <details class=\"noprint\"><summary class=\"small\">Modifier le budget</summary><div class=\"grid2\"><div><label for=\"rbMax\">Budget maximum (USD)</label><input type=\"number\" id=\"rbMax\" min=\"0\" step=\"0.5\"></div><div><label for=\"rbWarn\">Alerte (USD)</label><input type=\"number\" id=\"rbWarn\" min=\"0\" step=\"0.5\"></div></div>\n          <div class=\"row\" style=\"margin-top:8px\"><button class=\"btn small\" id=\"rbSave\">Mettre à jour le budget</button><span class=\"small muted\">Acte explicite, enregistré dans le run. Vide = aucun plafond.</span></div><div id=\"rbErr\" class=\"banner bad\" hidden></div></details>\n      </div>\n      <div id=\"stopBox\" class=\"row noprint\" hidden><button class=\"btn\" id=\"btnStop\" style=\"border-color:var(--bad);color:var(--bad)\">Arrêter le run</button><span class=\"small muted\" id=\"stopHint\">Aucun nouvel appel au service d'analyse après votre demande ; un appel déjà envoyé peut se terminer et être facturé. Les résultats déjà produits sont conservés.</span></div>\n      <div id=\"resumeBox\" class=\"noprint\" hidden><div class=\"small\" id=\"resumeSummary\"></div><div class=\"row\"><button class=\"btn\" id=\"btnResume\">Reprendre le run</button> <button class=\"btn\" id=\"btnReplayReviews\" hidden title=\"Rejoue uniquement les revues des jumeaux documentaires, l'agrégation, la qualification et le rapport depuis le panel déjà validé ; les revues déjà validées sont réutilisées sans appel.\">Rejouer les revues des jumeaux</button><span class=\"small muted\">Acte explicite : jamais de reprise automatique. Les résultats déjà validés sont conservés ; seul ce qui manque est recalculé (les réponses réelles déjà validées sont réutilisées, jamais recomptées comme nouvelles).</span></div></div>\n      <details class=\"noprint\" style=\"margin-top:8px\"><summary>Journal <span class=\"small muted\">(heure locale)</span></summary><div class=\"log\" id=\"log\"></div></details>\n    </div>\n\n    <!-- Porte 1 -->\n    <div class=\"card noprint\" id=\"gatePlan\" hidden>\n      <h2>Vérifiez, puis confirmez et lancez</h2>\n      <h3>Ce qu'EvidenceForge a compris</h3><div id=\"gpReformulation\"></div>\n      <h3>Angles d'expertise retenus</h3><ul id=\"gpDisciplines\"></ul>\n      <h3>Plan de recherche (requêtes qui seront exécutées dans la base de publications)</h3><ul id=\"gpPlan\" class=\"small\"></ul>\n      <!-- v1.0.17 : MISSION CONTRACT ENFORCEMENT — livrables demandes vs capacites de cette version, AVANT la confirmation -->\n      <h3>Livrables demandés — ce que cette version produira</h3><div id=\"gpDeliverables\" class=\"small\"></div>\n      <label id=\"gpAckBox\" class=\"banner warn small\" hidden><input type=\"checkbox\" id=\"gpAck\"> Je reconnais que les livrables marqués « NON PRODUIT » ne seront pas produits par ce run. Cette reconnaissance informe seulement : elle ne retire aucun livrable de ma demande, ils resteront signalés dans le rapport et le run ne sera pas présenté comme « terminé ».</label>\n      <div class=\"banner warn small\">Votre confirmation est un acte réel, enregistré à votre nom (le contrat de données d'EvidenceForge exige une validation humaine du plan). Aucune décision n'est prise à votre place.</div>\n      <label for=\"gpName\">Votre nom</label><input type=\"text\" id=\"gpName\" placeholder=\"Prénom Nom\">\n      <label for=\"gpComment\">Commentaire (facultatif)</label><input type=\"text\" id=\"gpComment\" placeholder=\"\">\n      <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn\" id=\"gpConfirm\">Confirmer et lancer l'analyse</button><button class=\"btn sec\" id=\"gpCancel\">Reformuler ma demande</button></div>\n      <div id=\"gpErr\" class=\"banner bad\" hidden></div>\n    </div>\n\n    <!-- Porte 2 -->\n    <!-- v1.0.7 : PORTE ECONOMIQUE (humaine) — projection avant les revues ; jamais un blocage scientifique -->\n    <div class=\"card noprint\" id=\"gateEconomics\" hidden>\n      <h2>Coût projeté avant les revues : votre confirmation est requise</h2>\n      <div class=\"banner warn small\" id=\"geWarn\"></div>\n      <div class=\"cost\" id=\"geCells\"></div>\n      <p class=\"small muted\" id=\"geExplain\"></p>\n      <div class=\"row\" style=\"margin-top:8px\"><input id=\"geName\" placeholder=\"Votre nom (acte réel)\" style=\"max-width:260px\"><button class=\"btn\" id=\"geConfirm\">Confirmer et lancer les revues</button><span class=\"small muted\">Ou réduisez le budget / arrêtez le run. La suffisance scientifique du panel n'est pas concernée par cette porte.</span></div>\n      <div id=\"geErr\" class=\"banner err small\" hidden></div>\n    </div>\n    <div class=\"card noprint\" id=\"gateSources\" hidden>\n      <h2>Ratifiez la sélection des publications</h2>\n      <p class=\"small muted\" id=\"gsSummary\"></p>\n      <div class=\"banner warn small\">Ces propositions sont fondées sur les métadonnées et résumés réels de chaque publication (aucun texte intégral lu). Vous pouvez inverser un choix. Votre ratification est un acte réel, enregistré à votre nom pour chaque source.</div>\n      <!-- v1.0.5 : revue d'ensemble du corpus (signaux, jamais une decision) -->\n      <div id=\"gsPortfolio\"></div>\n      <div class=\"row small\"><button class=\"btn sec small\" id=\"gsShowAll\">Tout afficher</button><span id=\"gsCount\" class=\"muted\"></span></div>\n      <div id=\"gsList\"></div>\n      <label for=\"gsName\">Votre nom</label><input type=\"text\" id=\"gsName\" placeholder=\"Prénom Nom\">\n      <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn\" id=\"gsConfirm\">Ratifier et poursuivre</button></div>\n      <div id=\"gsErr\" class=\"banner bad\" hidden></div>\n    </div>\n\n    <!-- Rapport -->\n    <div class=\"card\" id=\"report\" hidden>\n      <div class=\"row\"><h2>Rapport</h2><span class=\"grow\"></span><button class=\"btn sec small noprint\" id=\"btnJson\">Exporter JSON</button><button class=\"btn sec small noprint\" id=\"btnPdf\">Exporter PDF (imprimer)</button></div>\n      <div id=\"rpHead\"></div>\n      <div id=\"rpBody\"></div>\n    </div>\n  </section>\n\n  <!-- ================= MODE EXPERT ================= -->\n  <section id=\"expert\" hidden>\n    <div class=\"card\">\n      <div class=\"row\"><h2>Mode expert</h2><span class=\"small muted\" id=\"exRun\"></span></div>\n      <div id=\"exGate\" class=\"banner warn noprint\" hidden></div>\n      <div class=\"tabs\" id=\"exTabs\"></div>\n      <div id=\"exView\"></div>\n    </div>\n  </section>\n</main>\n\n<script>\n(function(){\n\"use strict\";\nconst $=(s)=>document.querySelector(s); const esc=(s)=>String(s==null?\"\":s).replace(/[&<>\"]/g,(c)=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst api=async(p,opt)=>{const r=await fetch(p,Object.assign({headers:{\"content-type\":\"application/json\"}},opt||{}));const j=await r.json().catch(()=>({}));if(!r.ok){const e=new Error(j.message||j.error||(\"HTTP \"+r.status));e.code=j.error;throw e;}return j;};\nlet CFG=null, RUN=null, ES=null, STATE=null, REPORT=null, GATE=null, EXTAB=\"state\";\nlet pendingFiles=[]; let overrides={}; let showAll=false;\n\n/* ---------- config ---------- */\n/* v1.0.5 : etat du fournisseur en trois niveaux (identifiants / joignable / pret) — « configuré » n'est jamais affiché sur un simple placeholder */\nfunction renderProvider(pv){const w=$(\"#providerWarn\");if(pv&&pv.ready){w.hidden=true;$(\"#start\").disabled=false;$(\"#cfgline\").textContent=CFG.product+\" \"+CFG.version+\" · \"+CFG.frozenLots.length+\" lots gelés vérifiés · service d'analyse prêt\";return;}\n  $(\"#start\").disabled=true;w.hidden=false;const lvl=!pv||!pv.credentialsPresent?\"identifiants absents\":pv.placeholderDetected?\"valeur factice détectée\":!pv.urlValid?\"adresse invalide\":pv.reachable===false?\"worker injoignable\":pv.authOk===false?\"clé refusée\":\"diagnostic en attente\";\n  w.innerHTML='<b>Le service d\\'analyse n\\'est pas prêt ('+esc(lvl)+').</b> '+esc(pv?pv.userMessage:\"\")+' <button class=\"btn small\" id=\"provRetry\" style=\"margin-left:8px\">Re-tester</button>';$(\"#provRetry\").onclick=async()=>{$(\"#provRetry\").disabled=true;try{renderProvider(await api(\"/api/provider?refresh=1\"));}catch(e){}};\n  $(\"#cfgline\").textContent=CFG.product+\" \"+CFG.version+\" · service d'analyse NON prêt\";}\napi(\"/api/config\").then(async(c)=>{CFG=c;$(\"#cfgline\").textContent=c.product+\" \"+c.version+\" · \"+c.frozenLots.length+\" lots gelés vérifiés\";renderProvider(c.provider);renderRunList();fromHash();try{renderProvider(await api(\"/api/provider\"));}catch(e){}}).catch((e)=>{$(\"#cfgline\").textContent=\"Serveur injoignable : \"+e.message;});\nasync function renderRunList(){try{const r=await api(\"/api/runs\");$(\"#runList\").innerHTML=r.runs.length?r.runs.map((x)=>'<div><a href=\"#\" data-run=\"'+esc(x.runId)+'\">'+esc(x.runId)+'</a> · '+esc(x.status)+' · '+esc((x.question||\"\").slice(0,80))+'</div>').join(\"\"):\"<em>Aucun run.</em>\";$(\"#runList\").querySelectorAll(\"a\").forEach((a)=>a.onclick=(ev)=>{ev.preventDefault();openRun(a.dataset.run);});}catch(e){}}\n\n/* ---------- mode ---------- */\n$(\"#mSimple\").onclick=()=>setMode(\"simple\");$(\"#mExpert\").onclick=()=>setMode(\"expert\");\n/* v1.0.5 : aide (panneau ferme par defaut, ne bloque jamais le parcours) */\n$(\"#btnHelp\").onclick=()=>{const h=$(\"#helpCard\");h.hidden=!h.hidden;if(!h.hidden)h.scrollIntoView({behavior:\"smooth\"});};$(\"#btnHelpClose\").onclick=()=>{$(\"#helpCard\").hidden=true;};\nfunction setMode(m){$(\"#simple\").hidden=m!==\"simple\";$(\"#expert\").hidden=m!==\"expert\";$(\"#mSimple\").classList.toggle(\"on\",m===\"simple\");$(\"#mExpert\").classList.toggle(\"on\",m===\"expert\");if(m===\"expert\")renderExpert();setHash();}\n/* l'URL porte le run et le mode : un rafraîchissement (F5) ou un lien rouvre exactement la même vue */\nfunction setHash(){const h=(RUN?\"run=\"+RUN:\"\")+($(\"#expert\").hidden?\"\":(RUN?\"&\":\"\")+\"mode=expert\");if(location.hash.slice(1)!==h)history.replaceState(null,\"\",\"#\"+h);}\nfunction fromHash(){const q=new URLSearchParams(location.hash.slice(1));const r=q.get(\"run\");if(r&&r!==RUN)openRun(r);if(q.get(\"mode\")===\"expert\")setMode(\"expert\");}\nwindow.addEventListener(\"hashchange\",fromHash);\n\n/* ---------- nouveau run ---------- */\n/* v1.0.6 AUTO-CHUNK UPLOAD : conversion base64 par blocs (aucun debordement de pile sur un long document), puis apercu LOCAL du decoupage\n   (/api/documents/preview : synchrone, sans appel IA, sans run). 1 fichier = 1 document, quel que soit le nombre de segments. */\nconst toBase64=(buf)=>{const u=new Uint8Array(buf);let b=\"\";for(let i=0;i<u.length;i+=0x8000)b+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));return btoa(b);};\nconst fmtInt=(n)=>Number(n).toLocaleString(\"fr-FR\");\nfunction renderDocPreview(pv){const rows=[];(pv.documents||[]).forEach((d)=>{rows.push('<div class=\"docrow\" data-doc-status=\"'+esc(d.ingestionStatus)+'\"><b>'+esc(d.name)+'</b> · '+fmtInt(d.characters)+' caractères → '+(d.segments===1?'1 segment':d.segments+' segments générés automatiquement')+' → <span class=\"pill\">'+(d.status===\"COMPLET\"?'document complet':'document incomplet')+'</span></div>');});\n  (pv.rejected||[]).forEach((r)=>{rows.push('<div class=\"docrow\" data-doc-status=\"'+esc(r.code||\"REFUSE\")+'\"><b>'+esc(r.name)+'</b> · <span class=\"pill\">'+(r.status===\"VIDE\"?'document vide — non exploitable':'refusé')+'</span> <span class=\"muted\">'+esc(r.reason)+'</span></div>');});\n  const n=pv.documentCount||0;rows.push('<div class=\"muted\" id=\"docCount\">'+(n===0?'Aucun document exploitable':n+' document'+(n>1?'s':'')+' · '+fmtInt(pv.segmentCount||0)+' segment'+((pv.segmentCount||0)>1?'s':'')+' au total (segments ≤ '+fmtInt(pv.maxChunkChars)+' caractères, lus intégralement)')+'</div>');$(\"#fileList\").innerHTML=rows.join(\"\");}\nlet filesSeq=0;\n$(\"#files\").onchange=async()=>{const seq=++filesSeq;const files=[];for(const f of $(\"#files\").files){const buf=await f.arrayBuffer();files.push({name:f.name,contentBase64:toBase64(buf)});}\n  if(seq!==filesSeq)return;/* une selection plus recente a pris le relais : jamais deux listes melangees */pendingFiles=files;\n  if(!pendingFiles.length){$(\"#fileList\").textContent=\"\";return;}$(\"#fileList\").textContent=\"Analyse des documents…\";\n  try{const pv=await api(\"/api/documents/preview\",{method:\"POST\",body:JSON.stringify({files:pendingFiles})});if(seq!==filesSeq)return;renderDocPreview(pv);}catch(e){$(\"#fileList\").textContent=pendingFiles.map((f)=>f.name).join(\", \")+\" (aperçu du découpage indisponible : \"+(e.message||e)+\")\";}};\nconst numOrNull=(v)=>{const t=String(v==null?\"\":v).trim();if(t===\"\")return null;const n=Number(t);return Number.isFinite(n)?n:null;};\nfunction budgetMode(){return $(\"#bModeUnlimited\").checked?\"UNLIMITED\":\"LIMITED\";}\nfunction budgetInput(){const m=budgetMode();return {mode:m===\"LIMITED\"?\"LIMITED\":\"UNLIMITED_CONFIRMED\",costBudgetUsd:m===\"LIMITED\"?numOrNull($(\"#bMax\").value):null,warningThresholdUsd:numOrNull($(\"#bWarn\").value)};}\nconst UNLIMITED_TEXT=\"Ce run n'aura aucun plafond automatique de coût.\\nLes appels fournisseur continueront jusqu'à la fin ou jusqu'à votre arrêt manuel.\";\n/* apercu EN DIRECT de ce qui sera enregistre (le run affichera ensuite exactement budget.json) */\nfunction renderBudgetPreview(){const b=budgetInput();const el=$(\"#bPreview\");$(\"#bMax\").disabled=b.mode!==\"LIMITED\";el.style.color=\"\";\n  if(b.mode===\"UNLIMITED_CONFIRMED\"){el.textContent=\"SANS PLAFOND : \"+UNLIMITED_TEXT.replace(\"\\n\",\" \")+\" Une confirmation explicite vous sera demandée au lancement.\";el.className=\"small\";el.style.color=\"var(--bad)\";return;}\n  if(b.costBudgetUsd===null||!(b.costBudgetUsd>0)){el.textContent=\"Plafond requis : indiquez un montant strictement positif (USD). Le run ne sera pas lancé sans plafond ni confirmation explicite.\";el.className=\"small\";el.style.color=\"var(--bad)\";return;}\n  if(b.warningThresholdUsd!==null&&b.warningThresholdUsd>=b.costBudgetUsd){el.textContent=\"Le seuil d'alerte doit être strictement inférieur au plafond.\";el.className=\"small\";el.style.color=\"var(--bad)\";return;}\n  el.textContent=\"Sera enregistré : plafond \"+b.costBudgetUsd.toFixed(2)+\" USD · \"+(b.warningThresholdUsd!==null?\"alerte à \"+b.warningThresholdUsd.toFixed(2)+\" USD\":\"aucune alerte\")+\" (budget.json écrit avant tout appel).\";el.className=\"small\";}\n$(\"#bMax\").oninput=renderBudgetPreview;$(\"#bWarn\").oninput=renderBudgetPreview;$(\"#budgetDetails\").ontoggle=renderBudgetPreview;$(\"#bModeLimited\").onchange=renderBudgetPreview;$(\"#bModeUnlimited\").onchange=renderBudgetPreview;renderBudgetPreview();\n$(\"#start\").onclick=async()=>{const q=$(\"#q\").value.trim();if(q.length<12){alert(\"Décrivez votre demande (12 caractères minimum).\");return;}const budget=budgetInput();\n  /* RUN SAFETY : jamais un lancement payant sans plafond explicite ou sans confirmation explicite « sans plafond » */\n  if(budget.mode===\"LIMITED\"){if(budget.costBudgetUsd===null||!(budget.costBudgetUsd>0)){alert(\"Indiquez un plafond de coût strictement positif (USD), ou choisissez explicitement « Sans plafond » et confirmez.\");$(\"#budgetDetails\").open=true;return;}\n    if(budget.warningThresholdUsd!==null&&budget.warningThresholdUsd>=budget.costBudgetUsd){alert(\"Le seuil d'alerte doit être strictement inférieur au plafond.\");return;}}\n  else{if(!confirm(UNLIMITED_TEXT+\"\\n\\nConfirmez-vous le lancement SANS plafond de coût ?\"))return;budget.confirmedUnlimited=true;}\n  $(\"#start\").disabled=true;\n  try{let r;try{r=await api(\"/api/runs\",{method:\"POST\",body:JSON.stringify({question:q,files:pendingFiles,budget})});}\n    catch(e){if(e.code===\"DOCUMENTS_REJECTED\"){/* jamais un lancement silencieux sans le document : confirmation explicite */if(!confirm(e.message+\"\\n\\nOK = continuer sans ce(s) document(s) · Annuler = corriger mes fichiers\"))return;r=await api(\"/api/runs\",{method:\"POST\",body:JSON.stringify({question:q,files:pendingFiles,acknowledgeRejected:true,budget})});}else throw e;}\n    if(r.rejected&&r.rejected.length)$(\"#fileList\").textContent=\"Documents refusés (run lancé sans eux) : \"+r.rejected.map((x)=>x.name).join(\", \");askNotifyPermission();openRun(r.runId);\n    /* confirmation de ce qui a ete reellement enregistre (budget.json), jamais ce qui a ete saisi */\n    if(r.budget){const um=$(\"#userMsg\");um.hidden=false;um.className=\"banner \"+(r.budget.mode===\"UNLIMITED_CONFIRMED\"?\"warn\":\"info\");um.textContent=\"Run créé · budget enregistré : \"+(r.budget.costBudgetUsd!=null?\"plafond \"+Number(r.budget.costBudgetUsd).toFixed(2)+\" USD\":\"AUCUN PLAFOND (confirmé explicitement)\")+\" · \"+(r.budget.warningThresholdUsd!=null?\"alerte à \"+Number(r.budget.warningThresholdUsd).toFixed(2)+\" USD\":\"aucune alerte\")+\".\";}}catch(e){alert(e.message);}finally{$(\"#start\").disabled=false;}};\n/* v1.0.5 : « Vérifier ma demande avec l'IA » — hors run ; l'IA propose ; la zone de texte n'est modifiee que sur clic explicite ; l'original reste disponible */\nlet PRE_ORIGINAL=null;\n$(\"#btnPreflight\").onclick=async()=>{const q=$(\"#q\").value.trim();if(q.length<12){alert(\"Décrivez votre demande (12 caractères minimum).\");return;}const box=$(\"#preflightBox\");box.hidden=false;box.className=\"banner info\";box.textContent=\"Vérification en cours (un appel au service d'analyse)…\";$(\"#btnPreflight\").disabled=true;\n  try{const r=await api(\"/api/preflight\",{method:\"POST\",body:JSON.stringify({question:q,files:pendingFiles})});PRE_ORIGINAL=r.original.question;const v=r.review;\n    const probs=(v.problemes||[]).map((p)=>'<li><b>'+esc(p.type.replace(/_/g,\" \").toLowerCase())+'</b> — '+esc(p.detail)+(p.extrait?' <span class=\"muted\">« '+esc(p.extrait)+' »</span>':'')+'</li>').join(\"\");\n    box.className=\"banner \"+((v.problemes||[]).length?\"warn\":\"ok\");\n    box.innerHTML='<div><b>Contrôle de cadrage</b> — clarté : '+esc(v.clarte)+' · neutralité : '+esc(v.neutralite)+' · coût de cette vérification : '+(r.cost&&r.cost.thisCheckUsd!=null?r.cost.thisCheckUsd.toFixed(2)+' USD':'n/a')+'</div>'\n      +((v.problemes||[]).length?'<div class=\"small\" style=\"margin-top:6px\"><b>Problèmes détectés :</b><ul>'+probs+'</ul></div>':'<div class=\"small\" style=\"margin-top:6px\">Aucun problème de cadrage détecté.</div>')\n      +((v.questionsAPoser||[]).length?'<div class=\"small\"><b>À trancher avant de lancer :</b><ul>'+v.questionsAPoser.map((x)=>'<li>'+esc(x)+'</li>').join(\"\")+'</ul></div>':'')\n      +(r.proposalDiffers?'<div class=\"small\" style=\"margin-top:6px\"><b>Reformulation proposée :</b><div class=\"why\">'+esc(v.propositionReformulee)+'</div><div class=\"row\" style=\"margin-top:6px\"><button class=\"btn small\" id=\"preUse\">Utiliser cette reformulation</button><button class=\"btn sec small\" id=\"preKeep\">Garder ma demande</button></div></div>':'<div class=\"small\" style=\"margin-top:6px\">Aucune reformulation proposée : votre demande est conservée telle quelle.</div>')\n      +'<div class=\"small muted\" style=\"margin-top:6px\">'+esc(r.statement)+'</div>';\n    const use=$(\"#preUse\");if(use)use.onclick=()=>{$(\"#q\").value=v.propositionReformulee;box.innerHTML='<div>Reformulation appliquée dans la zone de saisie (vous pouvez encore la modifier). <button class=\"btn sec small\" id=\"preRevert\">Revenir à ma demande d\\'origine</button></div>';$(\"#preRevert\").onclick=()=>{$(\"#q\").value=PRE_ORIGINAL;box.hidden=true;};};\n    const keep=$(\"#preKeep\");if(keep)keep.onclick=()=>{box.hidden=true;};}\n  catch(e){box.className=\"banner bad\";box.textContent=\"Vérification impossible : \"+e.message+\" — votre demande est inchangée.\";}finally{$(\"#btnPreflight\").disabled=false;}};\n$(\"#importReport\").onchange=async()=>{const f=$(\"#importReport\").files[0];if(!f)return;$(\"#importErr\").hidden=true;try{const report=JSON.parse(await f.text());const r=await api(\"/api/reports/import\",{method:\"POST\",body:JSON.stringify({report})});openRun(r.runId);}catch(e){$(\"#importErr\").hidden=false;$(\"#importErr\").textContent=e.message;}};\n$(\"#btnNew\").onclick=()=>{closeRun();$(\"#newRun\").hidden=false;setHash();};\nfunction closeRun(){if(ES){ES.close();ES=null;}if(POLL){clearInterval(POLL);POLL=null;}RUN=null;STATE=null;REPORT=null;GATE=null;overrides={};[\"#runCard\",\"#gatePlan\",\"#gateSources\",\"#report\"].forEach((s)=>$(s).hidden=true);}\n\n/* ---------- suivi d'un run ---------- */\nlet POLL=null;\nfunction openRun(runId){closeRun();SEEN_EVENTS.clear();RUN=runId;COST=null;$(\"#newRun\").hidden=true;$(\"#runCard\").hidden=false;$(\"#log\").innerHTML=\"\";$(\"#exRun\").textContent=runId;setHash();loadCost();\n  ES=new EventSource(\"/api/runs/\"+runId