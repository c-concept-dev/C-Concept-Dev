NEL_SIZE!=null?pj.INITIAL_PANEL_SIZE:\"—\"],[\"Professionnels approuvés\",pj.PANEL_SIZE],[\"Jumeaux potentiels\",pj.EXPECTED_TWINS],[\"Revues complètes attendues\",pj.EXPECTED_REVIEWS+(rt?\" (\"+(rt.mode===\"MISSION_DOSSIER\"?\"1 dossier de mission, \"+rt.sourceDocumentCount+\" documents\":rt.targets.length+\" cibles\")+\")\":\"\")],[\"Appels de revue attendus\",pj.EXPECTED_REVIEW_CALLS],[\"Angles\",pj.dimensions],[\"Déjà dépensé\",fmt(pj.spentUsd)],[\"Cause principale du coût\",pj.mainCostDriver||\"—\"]];\n  if(eco)cells.push([\"Panel par lots\",eco.batches.length+\" lot(s), \"+eco.evaluated+\" évalué(s), état \"+esc(eco.scientificPanelState)]);\n  $(\"#geCells\").innerHTML=cells.map(([k,v])=>'<div class=\"cell\"><div class=\"k\">'+esc(k)+'</div><div class=\"v\">'+v+'</div></div>').join(\"\");\n  $(\"#geExplain\").textContent=\"Cette porte est économique : elle ne juge pas la science. Le panel a été constitué par la politique de suffisance ; confirmer lance les revues des jumeaux avec le coût projeté ci-dessus. Vous pouvez aussi arrêter le run ou ajuster le budget.\";}\n$(\"#geConfirm\").onclick=async()=>{$(\"#geConfirm\").disabled=true;try{const r=await api(\"/api/runs/\"+RUN+\"/confirm-economics\",{method:\"POST\",body:JSON.stringify({confirmedBy:$(\"#geName\").value})});$(\"#gateEconomics\").hidden=true;$(\"#gateNotify\").hidden=true;lastGate=null;document.title=\"EvidenceForge\";const um=$(\"#userMsg\");um.hidden=false;um.className=\"banner ok\";um.textContent=\"Coût projeté accepté par \"+r.confirmedBy+\" : les revues sont lancées.\";}\n  catch(e){$(\"#geErr\").hidden=false;$(\"#geErr\").textContent=e.message;}finally{$(\"#geConfirm\").disabled=false;}};\n/* v1.0.17 : livrables demandes (porte 1) — un livrable non garanti exige une reconnaissance explicite, liee a l'empreinte de l'evaluation affichee */\nlet GATE_DLV=null;\nfunction renderDeliverablesGate(a){GATE_DLV=a||null;const box=$(\"#gpDeliverables\");if(!a){box.innerHTML='<p class=\"muted\">Évaluation des livrables indisponible.</p>';$(\"#gpAckBox\").hidden=true;return;}\n  box.innerHTML=(a.deliverables.length?'<ul>'+a.deliverables.map((d)=>'<li>'+(d.gateClass===\"SUPPORTED\"?'<span class=\"pill\">produit</span> ':'<span class=\"pill\" style=\"background:var(--bad,#b00);color:#fff\">NON PRODUIT</span> ')+'<b>'+esc(d.deliverableId)+'</b> '+esc(d.capabilityLabel||\"livrable non reconnu\")+' — « '+esc(d.clause)+' »'+(d.condition?' <span class=\"muted\">(conditionnel : '+esc(d.condition)+')</span>':'')+(d.gateClass===\"SUPPORTED\"?'':'<div class=\"muted\">'+esc(d.reason||\"\")+'</div>')+'</li>').join(\"\")+'</ul>':'<p class=\"muted\">Aucun livrable détecté dans le livrable confirmé.</p>')\n    +((a.excluded||[]).length?'<p class=\"muted\">Exclus par votre demande (formulés en négation) : '+a.excluded.map((x)=>esc(x.capabilityId)).join(\", \")+'</p>':'')\n    +'<p class=\"muted hash\">registre '+esc(a.registryId)+' · évaluation '+esc(String(a.assessmentSha256).slice(0,16))+'…</p>';\n  $(\"#gpAckBox\").hidden=!a.acknowledgementRequired;$(\"#gpAck\").checked=false;}\n$(\"#gpConfirm\").onclick=async()=>{$(\"#gpConfirm\").disabled=true;askNotifyPermission();try{const body={validatedBy:$(\"#gpName\").value,commentaire:$(\"#gpComment\").value};if(GATE_DLV&&GATE_DLV.acknowledgementRequired){body.deliverablesAcknowledged=$(\"#gpAck\").checked===true;body.deliverablesAssessmentSha256=GATE_DLV.assessmentSha256;}const r=await api(\"/api/runs/\"+RUN+\"/confirm-plan\",{method:\"POST\",body:JSON.stringify(body)});\n    /* retour immediat : la confirmation est recue et l'analyse est lancee ; l'etat reel est relu tout de suite */\n    $(\"#gatePlan\").hidden=true;$(\"#gateNotify\").hidden=true;lastGate=null;document.title=\"EvidenceForge\";const um=$(\"#userMsg\");um.hidden=false;um.className=\"banner ok\";um.textContent=\"Confirmation reçue (\"+r.validatedBy+\"). L'analyse est lancée.\";$(\"#runStatus\").textContent=\"en cours\";$(\"#runStatus\").className=\"pill\";refreshState();}\n  catch(e){$(\"#gpErr\").hidden=false;$(\"#gpErr\").textContent=e.message;}finally{$(\"#gpConfirm\").disabled=false;}};\n$(\"#gpCancel\").onclick=()=>{closeRun();$(\"#newRun\").hidden=false;};\n\n/* ---------- porte 2 ---------- */\nfunction decisionOf(p){return overrides[p.sourceId]||p.proposed||p.defaultDecision||\"exclu\";}\nfunction ovKey(){return \"efm-overrides-\"+RUN;}function saveOverrides(){try{localStorage.setItem(ovKey(),JSON.stringify(overrides));}catch(e){}}function restoreOverrides(){try{const v=localStorage.getItem(ovKey());if(v)overrides=JSON.parse(v)||{};}catch(e){overrides={};}}\n/* v1.0.5 : revue d'ensemble du corpus — signaux lisibles AVANT de ratifier ; aucun bouton n'optimise ni ne ratifie a votre place */\nfunction renderPortfolio(g){const pf=g.portfolio;const el=$(\"#gsPortfolio\");if(!pf){el.innerHTML=\"\";return;}const byId=new Map(g.proposals.map((p)=>[p.sourceId,p]));const t=(id)=>{const p=byId.get(id);return p&&p.titre?p.titre:id;};\n  const balance=pf.balancing; const statusById=new Map(((balance&&balance.statuses)||[]).map(x=>[x.dimensionId,x]));\n  const cov=Object.keys(pf.coverageMap||{}).map((k)=>pf.coverageMap[k]);const max=Math.max(1,...cov.map((c)=>c.proposedIncluded));const under=new Set((pf.possibleUndercoverage||[]).map((u)=>u.dimensionId)),over=new Set((pf.possibleOvercoverage||[]).map((o)=>o.dimensionId));\n  let h='<details open><summary>Vue d\\'ensemble du corpus proposé <span class=\"tag\">signaux, pas une décision</span></summary><p class=\"small muted\">'+esc(pf.statement)+'</p>';\n  h+='<div class=\"small\"><b>Sources incluses proposées : '+pf.counts.proposedIncluded+'</b> sur '+pf.counts.sources+'</div><div style=\"margin:6px 0\"><b class=\"small\">Couverture par angle d\\'expertise</b>'+cov.map((c)=>'<div class=\"covrow\"><span>'+esc(c.label||c.dimensionId)+'</span><span><span class=\"bar'+(under.has(c.dimensionId)?\" bad\":over.has(c.dimensionId)?\" warn\":\"\")+'\" style=\"width:'+Math.round(100*c.proposedIncluded/max)+'%\"></span> '+c.proposedIncluded+' incluse(s) / '+c.found+' trouvée(s)</span><span class=\"small muted\">'+(balance?esc((statusById.get(c.dimensionId)||{}).message||\"\")+(over.has(c.dimensionId)?\" Surreprésentation.\":\"\"):(under.has(c.dimensionId)?\"sous-couverture possible\":over.has(c.dimensionId)?\"surreprésentation possible\":\"\"))+'</span></div>').join(\"\")+'</div>';\n  if(balance)h+='<p class=\"small\">Couverture de la proposition machine (avant vos modifications). Contribution multi-angle fractionnée ; au moins '+esc(balance.policy.minimumIndependentSources)+' sources indépendantes pour un signal satisfaisant. Coût additionnel du rééquilibrage : 0 USD.</p><details><summary>Ajustements proposés ('+balance.adjustments.length+')</summary>'+balance.adjustments.map(a=>'<p class=\"small\"><b>'+esc(a.kind)+'</b> — ajout : '+esc(t(a.added))+(a.removed?' ; retrait : '+esc(t(a.removed)):'')+'<br>'+esc(a.reason)+(a.donorReason?'<br>'+esc(a.donorReason):'')+'</p>').join('')+'</details>';\n  if((pf.redundancyGroups||[]).length)h+='<div style=\"margin:6px 0\"><b class=\"small\">Groupes potentiellement redondants</b>'+pf.redundancyGroups.map((gr,i)=>'<div class=\"small\" style=\"margin:4px 0\"><b>Groupe '+(i+1)+'</b> (similarité lexicale)<ul style=\"margin:2px 0\">'+gr.sourceIds.map((id)=>'<li>'+esc(t(id))+'</li>').join(\"\")+'</ul></div>').join(\"\")+'</div>';\n  if((pf.methodologicalCrossDomainCandidates||[]).length)h+='<div style=\"margin:6px 0\"><b class=\"small\">Méthodes génériques hors domaine (statut proposé indiqué pour chaque source)</b>'+pf.methodologicalCrossDomainCandidates.map((c)=>'<div class=\"small\" style=\"margin:4px 0\">• '+esc(t(c.sourceId))+' — '+esc((byId.get(c.sourceId)||{}).proposed||'sans proposition')+'<br><span class=\"muted\">domaine : '+esc(c.domainRelevance)+' · intérêt méthodologique : '+esc(c.methodologicalRelevance)+(c.methodologicalInterest?' — '+esc(c.methodologicalInterest):'')+'</span></div>').join(\"\")+'</div>';\n  if(pf.llmStatus!==\"DONE\")h+='<div class=\"small muted\">Distinction domaine / méthode : '+esc({SKIPPED:\"non exécutée\",NOTHING_TO_JUDGE:\"aucune source exclue avec résumé\",UNAVAILABLE:\"indisponible (fournisseur)\",PARTIAL:\"partielle\"}[pf.llmStatus]||pf.llmStatus)+'.</div>';\n  const other=(pf.warnings||[]).filter((w)=>[\"POSSIBLE_REDUNDANCY\",\"GENERIC_METHOD_OUTSIDE_DOMAIN\"].indexOf(w.code)===-1);if(other.length)h+='<ul class=\"small\">'+other.map((w)=>'<li>'+esc(w.message)+'</li>').join(\"\")+'</ul>';\n  h+='</details>';el.innerHTML=h;}\nfunction renderSources(){const g=GATE;const s=g.summary;renderPortfolio(g);$(\"#gsSummary\").textContent=s.sources+\" publication(s) trouvée(s) · \"+s.judged+\" évaluée(s) · \"+s.duplicates+\" doublon(s)\"+(s.failed?\" · \"+s.failed+\" sans proposition (seront exclues par prudence, sauf votre choix)\":\"\");\n  const props=g.proposals.slice();const inc=props.filter((p)=>decisionOf(p)===\"inclus\").length;$(\"#gsCount\").textContent=inc+\" incluse(s) / \"+props.length;\n  const list=showAll?props:props.filter((p)=>decisionOf(p)===\"inclus\").concat(props.filter((p)=>decisionOf(p)!==\"inclus\").slice(0,10));\n    const flags=new Map();((g.portfolio&&g.portfolio.suggestedReview)||[]).forEach((x)=>flags.set(x.sourceId,x.reasons));\n    $(\"#gsList\").innerHTML=list.map((p)=>{const d=decisionOf(p);const noProp=!p.proposed;const fl=flags.get(p.sourceId);return '<div class=\"src'+(noProp?' noprop':'')+'\"><div class=\"t\">'+esc(p.titre||p.sourceId)+(fl?fl.map((r)=>'<span class=\"tag\">'+esc({POSSIBLE_REDUNDANCY:\"redondance possible\",METHODOLOGICAL_RELEVANCE_DESPITE_DOMAIN:\"méthode hors domaine\",UNDERCOVERED_DIMENSION_EXCLUDED_SOURCE:\"angle sous-couvert\"}[r.code]||r.code)+'</span>').join(\"\"):\"\")+'</div><div class=\"r\">'+esc([p.annee,p.lieu].filter(Boolean).join(\" · \"))+(p.doi?' · <a href=\"'+esc(p.doi)+'\" target=\"_blank\" rel=\"noopener\">DOI</a>':'')+'</div><div class=\"r\"><b>'+(noProp?'Sans proposition machine :':'Proposition :')+'</b> '+(noProp?'':esc(p.proposed)+' — ')+esc(p.justification||\"\")+(p.evidence&&p.evidence.length?' <i>(« '+esc(p.evidence.slice(0,2).join(\" » ; « \"))+' »)</i>':'')+(p.confiance?' · confiance '+esc(p.confiance):'')+'</div>'+(p.resume?'<details><summary class=\"small\">Résumé</summary><div class=\"small\">'+esc(p.resume)+'</div></details>':'')+(p.proposed===\"doublon\"?'<div class=\"dec\"><button class=\"on doublon\" disabled>doublon de '+esc(p.duplicateOf)+'</button></div>':'<div class=\"dec\" data-id=\"'+esc(p.sourceId)+'\"><button class=\"'+(d===\"inclus\"?\"on inclus\":\"\")+'\" data-d=\"inclus\">inclure</button><button class=\"'+(d===\"exclu\"?\"on exclu\":\"\")+'\" data-d=\"exclu\">exclure</button>'+(noProp?'<span class=\"small muted\">décision explicite requise (défaut : exclure)</span>':'')+'</div>')+'</div>';}).join(\"\");\n  $(\"#gsList\").querySelectorAll(\".dec[data-id] button\").forEach((b)=>b.onclick=()=>{const id=b.parentNode.dataset.id;const p=props.find((x)=>x.sourceId===id);const baseline=p.proposed||p.defaultDecision||\"exclu\";if(b.dataset.d===baseline)delete overrides[id];else overrides[id]=b.dataset.d;saveOverrides();renderSources();});}\n$(\"#gsShowAll\").onclick=()=>{showAll=!showAll;renderSources();};\n$(\"#gsConfirm\").onclick=async()=>{$(\"#gsConfirm\").disabled=true;try{const r=await api(\"/api/runs/\"+RUN+\"/ratify-sources\",{method:\"POST\",body:JSON.stringify({ratifiedBy:$(\"#gsName\").value,overrides})});\n    try{localStorage.removeItem(ovKey());}catch(e){}$(\"#gateSources\").hidden=true;$(\"#gateNotify\").hidden=true;lastGate=null;document.title=\"EvidenceForge\";const um=$(\"#userMsg\");um.hidden=false;um.className=\"banner ok\";um.textContent=\"Ratification reçue (\"+r.ratifiedBy+\", \"+r.overrides+\" choix modifié(s)). L'analyse se poursuit.\";$(\"#runStatus\").textContent=\"en cours\";$(\"#runStatus\").className=\"pill\";refreshState();}\n  catch(e){$(\"#gsErr\").hidden=false;$(\"#gsErr\").textContent=e.message;}finally{$(\"#gsConfirm\").disabled=false;}};\n\n/* ---------- rapport ---------- */\nasync function loadReport(){try{REPORT=await api(\"/api/runs/\"+RUN+\"/report\");}catch(e){return;}renderReport();}\nfunction why(list){return '<details class=\"why\"><summary>Pourquoi EvidenceForge dit cela ?</summary>'+list.map((w)=>{if(w.missing)return '<div class=\"muted\">constat introuvable : '+esc(w.findingId)+'</div>';const t=w.twin||{};const pr=t.professional||{};return '<div style=\"margin:6px 0;padding-bottom:6px;border-bottom:1px solid var(--line)\"><div><b>Constat</b> ('+esc(w.disposition)+', '+esc(w.epistemicStatus)+', confiance '+esc(w.confidence)+') : '+esc(w.finding)+'</div><div class=\"small\"><b>Raisonnement :</b> '+esc(w.rationale)+'</div>'+(w.targetEvidence.length?'<div class=\"small\"><b>Passages de votre document :</b> « '+w.targetEvidence.map(esc).join(\" » ; « \")+' »</div>':'')+'<div class=\"small\"><b>Jumeau documentaire de :</b> '+esc(pr.displayName||\"?\")+(pr.affiliation?' ('+esc(pr.affiliation)+')':'')+(pr.openAlexAuthorId?' · <a href=\"'+esc(pr.openAlexAuthorId)+'\" target=\"_blank\" rel=\"noopener\">identifiant OpenAlex</a>':'')+(pr.orcid?' · ORCID '+esc(pr.orcid):'')+'</div>'+(w.twinBasisWorks.length?'<div class=\"small\"><b>Publications réelles mobilisées :</b> '+w.twinBasisWorks.map(esc).join(\" ; \")+'</div>':'')+((t.seedSources||[]).length?'<div class=\"small\"><b>Source ratifiée à l\\'origine :</b> '+t.seedSources.map((s)=>esc(s.titre)).join(\" ; \")+'</div>':'')+(w.limitations.length?'<div class=\"small muted\"><b>Limites déclarées :</b> '+w.limitations.map(esc).join(\" ; \")+'</div>':'')+'</div>';}).join(\"\")+'</details>';}\nfunction stmt(cls,s){const ctx='<span class=\"small muted\">'+esc(s.targetLabel)+' · '+esc(s.dimensionLabel)+'</span>';if(s.kind===\"DIVERGENCE\")return '<div class=\"stmt '+cls+'\">'+ctx+'<div><b>Positions divergentes</b></div>'+s.branches.map((b,i)=>'<div style=\"margin:6px 0\"><b>Position '+(i+1)+'</b> ('+b.twinCount+' jumeau(x)) : '+esc(b.position)+why(b.why)+'</div>').join(\"\")+'</div>';\n  return '<div class=\"stmt '+cls+'\">'+ctx+'<div>'+(s.dispositionLabel?'<span class=\"pill\">'+esc(s.dispositionLabel)+'</span> ':'')+(s.independentTwinCount?'<span class=\"pill\">'+s.independentTwinCount+' jumeaux indépendants</span> ':'')+(s.kind&&s.kind!==\"CONVERGENCE\"?'<span class=\"pill\">'+esc({NOT_DETERMINABLE:\"non déterminable\",EVIDENCE_GAP:\"manque documentaire\",SINGLE_TWIN_CONVERGENCE_REJECTED:\"convergence mono-jumeau rejetée\",ISOLATED_CAUTIOUS_INFERENCE:\"inférence prudente isolée\",ISOLATED_FINDING:\"constat isolé\"}[s.kind]||s.kind)+'</span>':'')+'</div><div style=\"margin-top:4px\">'+esc(s.statement)+'</div>'+why(s.why)+'</div>';}\n/* v1.0.17 : livrables demandes vs produits (jamais un verdict ; un rapport anterieur sans ce champ est affiche tel quel) */\nfunction deliverablesSection(md){if(!md)return '';const lab={PRODUCED:\"produit\",NOT_PRODUCED_BY_DESIGN:\"non produit par conception\",NOT_PRODUCED_ERROR:\"non produit (erreur)\"};\n  return '<h3>Livrables demandés <span class=\"pill\">'+md.items.length+'</span></h3><div class=\"banner '+(md.overall===\"COMPLETE\"?\"ok\":md.overall===\"INCOMPLETE\"?\"bad\":\"warn\")+' small\"><b>MISSION_DELIVERABLES = '+esc(md.overall)+'</b> — produits '+md.summary.PRODUCED+' · non produits par conception '+md.summary.NOT_PRODUCED_BY_DESIGN+' · non produits (erreur) '+md.summary.NOT_PRODUCED_ERROR+(md.acceptedMissing.length?' · <b>acceptés manquants : '+md.acceptedMissing.map(esc).join(\", \")+'</b>':'')+'</div><ul class=\"small\">'\n   +md.items.map((i)=>'<li><b>'+esc(i.deliverableId)+'</b> '+esc(i.capabilityLabel||\"livrable non reconnu\")+' — <span class=\"pill\">'+esc(lab[i.status]||i.status)+'</span>'+(i.acknowledgedAsNotProduced?' <span class=\"muted\">(reconnu non produit avant le lancement)</span>':'')+' <span class=\"muted\">« '+esc(i.clause)+' »</span>'+(i.reason?'<div class=\"muted\">'+esc(i.reason)+'</div>':'')+(i.evidence?'