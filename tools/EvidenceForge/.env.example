# EvidenceForge — modèle de configuration locale. Copiez-le en `.env.local` (ou lancez ./tools/EvidenceForge/setup.sh qui l'écrit pour vous).
# `.env.local` est gitignoré, jamais dans un zip ni un manifeste. Les valeurs ci-dessous sont des PLACEHOLDERS : start.sh refuse de démarrer tant qu'elles n'ont pas été remplacées.
LLM_AUTH_MODE=delegated
LLM_WORKER_BASE_URL=https://TON_URL_WORKER.workers.dev
EVIDENCEFORGE_WORKER_API_KEY=TA_CLE
EVIDENCEFORGE_LLM_MODEL=claude-sonnet-4-6
EVIDENCEFORGE_PORT=8768
EVIDENCEFORGE_RUNS_ROOT=/chemin/vers/un/dossier/de/runs/hors/du/depot
EVIDENCEFORGE_HTTP_TIMEOUT_MS=180000
