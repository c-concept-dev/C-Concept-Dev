{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atelier-decision-groq",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GROQ_API_KEY"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://c-concept-dev.github.io",
    "FAST_CAPACITY_RETRY_THRESHOLD_MS": "0"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
